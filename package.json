{
  "name": "holo-studio",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "One idea. Every perspective. An invention studio for macOS.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "package:mac": "node scripts/require-build-space.mjs && npm run build && electron-builder --mac dir",
    "dist:mac": "node scripts/require-build-space.mjs && npm run build && electron-builder --mac zip"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "express": "^5.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@types/archiver": "^7.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.183.0",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^44.3.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.2",
    "lucide-react": "^0.577.0",
    "prettier": "^3.6.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "three": "^0.183.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "build": {
    "appId": "studio.holo.app",
    "productName": "Holo",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        "zip"
      ],
      "darkModeSupport": true,
      "icon": "public/holo.icns",
      "identity": "-"
    },
    "asar": true
  },
  "author": "Holo contributors"
}
